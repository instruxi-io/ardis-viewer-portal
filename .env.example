# ardis-ms base URL. The viewer calls {VITE_ARDIS_API_BASE}/api/v1/ardis/public/share/{guid}.
# For local dev: VITE_ARDIS_API_BASE=http://localhost:8080
VITE_ARDIS_API_BASE=https://gateway.instruxi.dev

# Enforcer gateway base for OTP authentication. Must point at the Enforcer
# gateway root, not at ardis-ms directly.
VITE_ENFORCER_BASE=https://gateway-staging.instruxi.dev/api/v1/enforcer
