# ardis-viewer-portal — local development config.
# Copy to .env.local (gitignored) and adjust. Vite only exposes VITE_* vars.
#
# These are baked into the bundle at BUILD time, not read at runtime. Changing a
# deployed value means a rebuild + redeploy, not an env edit in Cloudflare.

# ── ardis-ms API base ─────────────────────────────────────────────────────────
# The viewer calls {VITE_ARDIS_API_BASE}/api/v1/ardis/public/share/... so this is
# the ardis-ms origin WITHOUT the /api/v1/ardis suffix.
#   Staging:   https://ardis-ms-ix.fly.dev
#   Local ms:  http://localhost:8080
# This is NOT the Enforcer gateway. Pointing it at gateway.instruxi.dev makes
# every share lookup fail.
VITE_ARDIS_API_BASE=https://ardis-ms-ix.fly.dev

# ── Enforcer gateway ──────────────────────────────────────────────────────────
# Used only by the recipient OTP gate. Must include the /api/v1/enforcer prefix,
# and must be the same gateway ardis-ms validates the resulting JWT against or
# the JWT is rejected server-side.
#   Staging:    https://gateway-staging.instruxi.dev/api/v1/enforcer
#   Production: https://gateway.instruxi.dev/api/v1/enforcer  (not in use)
VITE_ENFORCER_BASE=https://gateway-staging.instruxi.dev/api/v1/enforcer
