# Base origin of the Ardis API (ardis-ms, served behind the Enforcer gateway).
# The viewer calls {VITE_ARDIS_API_BASE}/api/v1/ardis/public/share/{guid}.
#
# Production / staging default is the gateway origin.
# For local dev against a locally-run ardis-ms, use:
#   VITE_ARDIS_API_BASE=http://localhost:8080
VITE_ARDIS_API_BASE=https://gateway.instruxi.dev
